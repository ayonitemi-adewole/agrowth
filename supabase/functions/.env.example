# Secrets for the Edge Functions. Set them on a project with:
#   npx supabase secrets set --env-file supabase/functions/.env
# (copy this file to .env first; .env is git-ignored). Supabase provides SUPABASE_URL and
# the API keys itself.

# Identity checks: "mock" (simulated answers, the default) or "dojah".
IDENTITY_PROVIDER=mock

# Dojah, when IDENTITY_PROVIDER=dojah. From the Dojah dashboard → Developers → Configuration.
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# Leave empty for live; https://sandbox.dojah.io for sandbox keys.
DOJAH_BASE_URL=

# Online payments (investors paying pledges): "paystack", "mock" (simulated) or empty (off).
# The simulated gateway also needs investor_settings.allow_simulated_payments = true.
PAYMENTS_PROVIDER=
# Paystack, when PAYMENTS_PROVIDER=paystack: sk_test_… for testing, sk_live_… for real money.
# Its settlement account must be the trustee's escrow account.
PAYSTACK_SECRET_KEY=

# Weather (Open-Meteo). Leave empty for the free API (no sign-up; non-commercial use).
# For commercial use, an Open-Meteo subscription key.
OPEN_METEO_API_KEY=
# Paying out through the gateway: the trustee sends payments from its Paystack balance.
# Off unless "true". Uses PAYMENTS_PROVIDER and PAYSTACK_SECRET_KEY above, and the Paystack
# account must be the trustee's own, with transfers enabled and OTP on transfers off.
PAYOUTS_ENABLED=
