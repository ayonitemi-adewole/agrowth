# Copy to supabase/.env.demo for `npm run seed:demo`. Never commit the real file.
# Use a Supabase project set aside for demos. Values: Project Settings → API Keys.
SUPABASE_URL=https://your-demo-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The secret key bypasses every security rule. Keep it on your machine only.
SUPABASE_SECRET_KEY=sb_secret_...
# Shared by every demo account. Visitors to a hosted demo will be able to use it.
DEMO_PASSWORD=
