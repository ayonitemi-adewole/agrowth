# Copy to .env.local and fill in from Supabase: Project Settings → API.
# Both values are safe to ship in a browser app; row-level security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: one-click sign-in buttons for throwaway demo accounts.
# Anything in a VITE_ variable is visible in the browser — never use real accounts here.
# VITE_DEMO_PASSWORD=
# VITE_DEMO_ACCOUNTS=admin:admin@example.com,field_agent:agent@example.com,compliance_officer:compliance@example.com,cycle_manager:manager@example.com,trustee:trustee@example.com
