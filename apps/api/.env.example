# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL with the PostGIS extension (docker compose up -d db)
DATABASE_URL=postgres://agrowth:agrowth@localhost:5432/agrowth

# Long random strings: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Secret mixed into BVN/NIN hashes so raw identity numbers are never stored
PII_HASH_PEPPER=change-me-to-another-long-random-string

# Used once by `npm run seed:admin -w apps/api`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
